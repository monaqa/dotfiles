# Ghostty is only the host terminal here. Workspace, tab, and pane
# management is delegated to Herdr so the same shortcuts can survive the
# move from WezTerm.

# --- Shell / session -------------------------------------------------------

command = /Users/monaqa/.local/share/mise/installs/herdr/latest/herdr

# --- Font ------------------------------------------------------------------

font-family = "CommitMono-height105-nokern"
font-family = "Hack Nerd Font"
font-family = "Noto Sans CJK JP"
font-size = 16.0

# --- Window ----------------------------------------------------------------

window-height = 58
window-width = 187

# Ghostty tabs are intentionally unused. Let Herdr draw the active
# workspace/tab state.
macos-titlebar-style = hidden

# Treat Option as Alt so Alt+h/j/k/l can move between Herdr panes.
macos-option-as-alt = true

# --- Colors / opacity -------------------------------------------------------

background = 1e212b
foreground = e0ded7

palette = 0=272a35
palette = 1=ce828e
palette = 2=90c183
palette = 3=c9b054
palette = 4=88b6e5
palette = 5=bf84ba
palette = 6=75c1bc
palette = 7=9e9b94
palette = 8=88867f
palette = 9=ce828e
palette = 10=add59d
palette = 11=dcc778
palette = 12=a6cbf5
palette = 13=e3b7e0
palette = 14=99d5cf
palette = 15=cac7c0

background-opacity = 0.90
background-opacity-cells = true

# --- Ghostty-owned shortcuts ----------------------------------------------

keybind = cmd+enter=toggle_fullscreen
keybind = cmd+f=new_window
keybind = cmd+u=toggle_background_opacity

keybind = cmd+0=reset_font_size
keybind = cmd+ctrl+0=reset_font_size
keybind = cmd+-=decrease_font_size:1.0
keybind = cmd+shift+=increase_font_size:1.0

# Keep these free for shells/TUIs.
keybind = ctrl+q=text:\x11
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+_=unbind

# --- Herdr-owned shortcuts -------------------------------------------------

# Cmd chords are not encoded into normal terminal input, so "unbind" is not
# enough for Herdr to see them. Translate each Cmd chord into Herdr's
# Ctrl+S prefix (XOFF / 0x13) plus an action key.
keybind = cmd+t=text:\x13t
keybind = cmd+shift+t=text:\x13T
keybind = cmd+s=text:\x13s

keybind = cmd+h=text:\x13h
keybind = cmd+l=text:\x13l
keybind = cmd+shift+h=text:\x13H
keybind = cmd+shift+l=text:\x13L
keybind = cmd+j=text:\x13j
keybind = cmd+k=text:\x13k

keybind = cmd+d=text:\x13d
keybind = cmd+shift+-=text:\x13v
keybind = cmd+shift+]=text:\x13-
keybind = cmd+|=text:\x13-

keybind = alt+h=unbind
keybind = alt+j=unbind
keybind = alt+k=unbind
keybind = alt+l=unbind

keybind = cmd+y=text:\x13y
keybind = cmd+z=text:\x13z
